<?xml version="1.0" encoding="utf-8"?>
<!-- 地下鉄案内: clean departure-board widget, amber dot letters on black. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/board_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_board_bg"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/b_line"
        android:text="山手線 内回り"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#80C241"
            android:fontFamily="@font/dotgothic"
            android:maxLines="1"
            android:paddingStart="6dp"
            android:paddingTop="1dp"
            android:paddingEnd="6dp"
            android:paddingBottom="1dp"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextClock
            android:id="@+id/b_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/dotgothic"
            android:format12Hour="HH:mm"
            android:format24Hour="HH:mm"
            android:textColor="#C8C9D2"
            android:textSize="13sp"
            android:timeZone="Asia/Tokyo" />
    </LinearLayout>

    <TextView
        android:id="@+id/b_route"
        android:text="東京 → 上野"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:fontFamily="@font/dotgothic"
        android:maxLines="1"
        android:textColor="#FFFFFF"
        android:textSize="18sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/b_last_label"
        android:text="終電"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/dotgothic"
            android:textColor="#FFAA3C"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/b_last"
        android:text="00:30"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="@font/dotgothic"
            android:textColor="#FFAA3C"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/b_bell"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/bell"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/b_first"
        android:text="始発 04:50"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/dotgothic"
            android:textColor="#8FE08F"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2E3038" />

    <TextView
        android:id="@+id/b_weather"
        android:text="晴れ 14.8°C  ·  降水確率 10%"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:fontFamily="@font/dotgothic"
        android:maxLines="1"
        android:textColor="#C8C9D2"
        android:textSize="12sp" />
</LinearLayout>
